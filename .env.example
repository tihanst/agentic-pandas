# LLM settings
# -----------

# External LLM API provider
PROVIDER=together
LLM_NAME=gptoss120b
IS_LOCAL=false
LLM_ENDPOINT=together_ai/openai/gpt-oss-120b
#specify exact key here if not set in environment
LLM_API_KEY_NAME=key

# Local LLM provider
PROVIDER=ollama
LLM_NAME=ollama/gpt-oss:20b
IS_LOCAL=true
LLM_ENDPOINT=http://localhost:11434
LLM_API_KEY=


# File settings
# ------------

TOP_LEVEL_OUTPUT_PATH=
